# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/ai_software_company

# Long random secret for JWT
JWT_SECRET=replace-with-a-long-random-secret

# Optional AI provider. Use either GEMINI_API_KEY or OPENAI_API_KEY.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional model names
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini

# Local development only
PORT=3000
